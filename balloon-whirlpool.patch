diff --git a/src/Miningcore/Crypto/Hashing/Algorithms/Balloon.cs b/src/Miningcore/Crypto/Hashing/Algorithms/Balloon.cs
new file mode 100644
index 0000000..3fc1b47
--- /dev/null
+++ b/src/Miningcore/Crypto/Hashing/Algorithms/Balloon.cs
@@ -0,0 +1,21 @@
+using Miningcore.Contracts;
+using Miningcore.Native;
+
+namespace Miningcore.Crypto.Hashing.Algorithms;
+
+[Identifier("balloon")]
+public unsafe class Balloon : IHashAlgorithm
+{
+    public void Digest(ReadOnlySpan<byte> data, Span<byte> result, params object[] extra)
+    {
+        Contract.Requires<ArgumentException>(result.Length >= 32);
+
+        fixed (byte* input = data)
+        {
+            fixed (byte* output = result)
+            {
+                Multihash.balloon(input, output, (uint) data.Length);
+            }
+        }
+    }
+}

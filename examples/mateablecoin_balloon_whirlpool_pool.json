{
    "logging": {
        "level": "info",
        "enableConsoleLog": true,
        "enableConsoleColors": true,
        "logFile": "",
        "apiLogFile": "",
        "logBaseDirectory": "",
        "perPoolLogFile": false
    },
    "banning": {
        "manager": "Integrated",
        "banOnJunkReceive": true,
        "banOnInvalidShares": false
    },
    "notifications": {
        "enabled": false
    },
    "persistence": {
        "postgres": {
            "host": "127.0.0.1",
            "port": 5432,
            "user": "miningcore",
            "password": "password",
            "database": "miningcore"
        }
    },
    "paymentProcessing": {
        "enabled": true,
        "interval": 600,
        "shareRecoveryFile": "recovered-shares.txt"
    },
    "api": {
        "enabled": true,
        "listenAddress": "*",
        "port": 4000
    },
    "pools": [
        {
            "id": "mtbc-balloon",
            "enabled": true,
            "coin": "mateablecoin-balloon",
            "address": "YOUR_MTBC_POOL_WALLET_ADDRESS",
            "rewardRecipients": [],
            "blockRefreshInterval": 1000,
            "jobRebroadcastTimeout": 10,
            "clientConnectionTimeout": 600,
            "banning": {
                "enabled": true,
                "time": 600,
                "invalidPercent": 50,
                "checkThreshold": 50
            },
            "gbtArgs": [{"rules": ["segwit"]}, "balloon"],
            "ports": {
                "3256": {
                    "listenAddress": "0.0.0.0",
                    "difficulty": 0.001,
                    "name": "balloon",
                    "varDiff": {
                        "minDiff": 0.0001,
                        "targetTime": 15,
                        "retargetTime": 90,
                        "variancePercent": 30
                    }
                }
            },
            "daemons": [
                {
                    "host": "YOUR_MTBC_NODE_HOST",
                    "port": 6966,
                    "user": "YOUR_RPC_USER",
                    "password": "YOUR_RPC_PASSWORD",
                    "httpPath": "/wallet/YOUR_WALLET_NAME"
                }
            ],
            "paymentProcessing": {
                "enabled": true,
                "minimumPayment": 0.5,
                "payoutScheme": "PPLNS",
                "payoutSchemeConfig": {
                    "factor": 2.0
                }
            }
        },
        {
            "id": "mtbc-whirlpool",
            "enabled": true,
            "coin": "mateablecoin-whirlpool",
            "address": "YOUR_MTBC_POOL_WALLET_ADDRESS",
            "rewardRecipients": [],
            "blockRefreshInterval": 1000,
            "jobRebroadcastTimeout": 10,
            "clientConnectionTimeout": 600,
            "banning": {
                "enabled": true,
                "time": 600,
                "invalidPercent": 50,
                "checkThreshold": 50
            },
            "gbtArgs": [{"rules": ["segwit"]}, "whirlpool"],
            "ports": {
                "3257": {
                    "listenAddress": "0.0.0.0",
                    "difficulty": 0.01,
                    "name": "whirlpool",
                    "varDiff": {
                        "minDiff": 0.001,
                        "targetTime": 15,
                        "retargetTime": 90,
                        "variancePercent": 30
                    }
                }
            },
            "daemons": [
                {
                    "host": "YOUR_MTBC_NODE_HOST",
                    "port": 6966,
                    "user": "YOUR_RPC_USER",
                    "password": "YOUR_RPC_PASSWORD",
                    "httpPath": "/wallet/YOUR_WALLET_NAME"
                }
            ],
            "paymentProcessing": {
                "enabled": true,
                "minimumPayment": 0.5,
                "payoutScheme": "PPLNS",
                "payoutSchemeConfig": {
                    "factor": 2.0
                }
            }
        }
    ]
}
